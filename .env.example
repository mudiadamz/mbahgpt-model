# Copy to .env and fill in. Real environment variables override these.
# Keep this file owner-only: chmod 600 .env
OPENROUTER_API_KEY=sk-or-v1-...

# Chat model and sampling. These are configured here, not in the web UI —
# the page only displays them. `./qwen.py --list` shows available slugs.
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_TEMPERATURE=0.7

# --- security -------------------------------------------------------------
# Required to bind anything other than 127.0.0.1. Without it the server
# refuses to start on a public interface, because an open port means anyone
# on the network can spend your credit and read your history.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# OPENROUTER_UI_TOKEN=

# Domain yang dilayani reverse proxy di depan server ini (koma sebagai pemisah).
# Server tetap bind 127.0.0.1, tapi browser mengirim "Host: contoh.com" — tanpa
# daftar ini penjaga DNS-rebinding menolaknya dengan 400. Begitu diisi, server
# menolak start tanpa OPENROUTER_UI_TOKEN. Lihat ARCHITECTURE.md §9.2.
# OPENROUTER_PUBLIC_HOST=contoh.com,www.contoh.com

# Percayai X-Forwarded-For dan X-Forwarded-Proto — hanya dari peer loopback.
# Tanpa ini, di belakang proxy semua klien terlihat sebagai 127.0.0.1 (rate
# limit jadi satu keranjang bersama) dan cookie token tidak ditandai Secure.
# OPENROUTER_TRUST_PROXY=0

# OPENROUTER_RATE_LIMIT=30          # chat requests per minute per client (0 = off)
# OPENROUTER_MAX_BODY=262144        # largest accepted request body, bytes

# --- eksekusi skrip (opt-in, baca ARCHITECTURE.md §5.5 dulu) ---------------
# Model bisa menjalankan skrip di mesin ini. Dibatasi waktu/memori/berkas, tapi
# skripnya tetap berjalan sebagai Anda dan bisa membaca home serta jaringan.
OPENROUTER_TOOLS=0                 # 1 = nyala
# OPENROUTER_TOOL_TIMEOUT=30
# OPENROUTER_TOOL_MEMORY_MB=512
# OPENROUTER_TOOL_ROUNDS=4

# --- limits ---------------------------------------------------------------
# OPENROUTER_MAX_UPLOAD=8388608     # total byte lampiran per pesan
# OPENROUTER_MAX_FILES=6            # jumlah berkas per pesan
# OPENROUTER_MAX_HISTORY=40         # messages resent per turn; caps cost on long chats
# OPENROUTER_TIMEOUT=120            # seconds to wait for OpenRouter

# --- optional -------------------------------------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DB=chats.db                                     # history database
# OPENROUTER_SEARCH_MODEL=qwen/qwen3-30b-a3b-instruct-2507   # digests web results
# OPENROUTER_WEB_RESULTS=5                                   # results per search
