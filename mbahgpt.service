[Unit]
# MbahGPT sebagai layanan systemd. Pasang dengan ./install-service.sh
Description=MbahGPT - local chat server (OpenRouter)
Documentation=file:///home/ubuntu/projects/mbahgpt/ARCHITECTURE.md
# Bind loopback tidak butuh jaringan, tapi panggilan ke OpenRouter butuh.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/mbahgpt
# Kredensial tetap dibaca dari .env oleh qwen.load_env, bukan dari unit ini —
# jadi kunci API tidak menggandakan diri ke /etc.
ExecStart=/usr/bin/python3 /home/ubuntu/projects/mbahgpt/server.py --host 127.0.0.1 --port 8000
# Tanpa ini stderr server ditahan buffer dan journal telat berisi.
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

# Hardening. ProtectHome sengaja TIDAK dipakai: repo, .env, dan chats.db ada di
# /home/ubuntu, jadi menyembunyikan /home akan mematikan layanan.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
